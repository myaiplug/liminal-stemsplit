{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [{ "source": "/", "destination": "/browser-split.html" }],
  "redirects": [
    { "source": "/workshop.html", "destination": "https://liminal-stemsplit.onrender.com/workshop.html", "permanent": false },
    { "source": "/funnel/:path*", "destination": "https://liminal-stemsplit.onrender.com/funnel/:path*", "permanent": false },
    { "source": "/privacy.html", "destination": "https://liminal-stemsplit.onrender.com/privacy.html", "permanent": false },
    { "source": "/terms.html", "destination": "https://liminal-stemsplit.onrender.com/terms.html", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" },
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/roformer-web/vendor/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/browser-split-sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ]
}
