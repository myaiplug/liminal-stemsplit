# Production values — set these in Render dashboard (Environment tab)
# Replace YOUR_RENDER_URL with your actual URL, e.g. https://liminal-stemsplit.onrender.com
# Or your custom domain, e.g. https://liminal.myaiplug.com

SITE_URL=https://liminal-stemsplit.onrender.com

RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=Liminal StemSplit <onboarding@resend.dev>
NOTIFY_EMAIL=you@example.com

# Stripe checkout (Payment Link is simplest)
STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/8x228r4Umgni2dq7PSffy00

# Optional: dynamic checkout instead of payment link
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...

# From Stripe Dashboard → Webhooks → your endpoint → Signing secret
# Endpoint URL: https://liminal-stemsplit.onrender.com/webhooks/stripe
# Event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

BILLING_ADMIN_TOKEN=generate_a_long_random_token