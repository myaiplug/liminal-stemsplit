{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "NoDAW Liminal main window — core IPC, events, dialogs, filesystem, and shell",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "dialog:default",
    "shell:default",
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": [
        "**",
        "$HOME/**",
        "$DESKTOP/**",
        "$DOCUMENT/**",
        "$DOWNLOAD/**",
        "$MUSIC/**",
        "$VIDEO/**",
        "$AUDIO/**",
        "$PUBLIC/**",
        "$PROGRAMFILES/**",
        "$PROGRAMFILESX86/**",
        "$LOCALDATA/**",
        "$APPDATA/**",
        "$TEMP/**"
      ]
    }
  ]
}