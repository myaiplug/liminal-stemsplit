# StemSplit Environment Configuration
# Copy this to .env.local and fill in your actual values

# ===== Simple Stripe Upgrade (pick one path) =====
# Path A — Dynamic Checkout Sessions (recommended)
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PRICE_ID=price_your_pro_price_id

# Path B — Static Stripe Payment Link (no server secret needed on desktop)
# NEXT_PUBLIC_STRIPE_CHECKOUT_URL=https://buy.stripe.com/your_payment_link

# Public URLs used by the desktop app
# Local dev:
# NEXT_PUBLIC_PRICING_PAGE_URL=http://localhost:4001/#pricing
# NEXT_PUBLIC_CHECKOUT_API_URL=http://localhost:4001/api/checkout
# Production (replace with your deployed URL):
NEXT_PUBLIC_PRICING_PAGE_URL=https://YOUR_RENDER_URL/#pricing
NEXT_PUBLIC_CHECKOUT_API_URL=https://YOUR_RENDER_URL/api/checkout

# Stripe webhook signing secret (billing service)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ===== License Server =====
# Local dev: http://localhost:4001
# Production: https://YOUR_RENDER_URL
STEMSPLIT_LICENSE_SERVER_URL=https://YOUR_RENDER_URL

# ===== Post-purchase activation email (Resend) =====
RESEND_API_KEY=re_xxxxx
STEMSPLIT_ONBOARDING_FROM=StemSplit <onboarding@resend.dev>
SITE_URL=http://localhost:4001

# ===== Optional Gumroad fallback =====
# NEXT_PUBLIC_GUMROAD_PRODUCT_URL=https://gumroad.com/l/stemsplit
# GUMROAD_WEBHOOK_SECRET=your_gumroad_webhook_secret

# Admin token for protected billing service endpoints
BILLING_ADMIN_TOKEN=replace_with_a_long_random_token

# ===== Support =====
NEXT_PUBLIC_SUPPORT_EMAIL=support@stemsplit.com

# ===== Python Configuration =====
PYTHON_PATH=python3
HARDWARE_BRAIN_PATH=./hardware_brain.py
SEPARATOR_ENGINE_PATH=./separator_engine.py

# ===== Feature Flags =====
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_ENFORCE_LICENSE=true
NEXT_PUBLIC_DEMO_LICENSE_KEY=STEM-DEMO-0000-0000-DEMO